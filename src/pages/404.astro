---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="请求的页面不存在。" noindex>
  <div class="container page">
    <header class="page-header"><span class="eyebrow">Error 404</span><h1>Page not found.</h1><p>这个地址可能已移动，或者从未存在。</p></header>
    <div class="button-row"><a class="button primary" href="/">Back home</a><a class="button" href="/search/">Search site</a></div>
  </div>
</BaseLayout>
