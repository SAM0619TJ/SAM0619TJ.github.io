---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { isPublished, slugifyTag } from '../../utils/content';
import { legacyMetadata } from '../../utils/legacy';

export const getStaticPaths = (async () => {
  const posts = (await getCollection('blog')).filter(isPublished);
  const notes = (await getCollection('notes')).filter(isPublished);
  const legacy = await getCollection('legacy');
  const tags = [...new Set([...posts, ...notes].flatMap((entry) => entry.data.tags).concat(legacy.flatMap((entry) => legacyMetadata(entry).tags)))];
  return tags.map((tag) => ({ params: { tag: slugifyTag(tag) }, props: { tag } }));
}) satisfies GetStaticPaths;

const { tag } = Astro.props;
const blog = (await getCollection('blog')).filter((entry) => isPublished(entry) && entry.data.tags.includes(tag)).map((entry) => ({ ...entry, kind: 'Blog' as const, href: `/blog/${entry.id}/`, category: undefined }));
const notes = (await getCollection('notes')).filter((entry) => isPublished(entry) && entry.data.tags.includes(tag)).map((entry) => ({ ...entry, kind: 'Note' as const, href: `/notes/${entry.id}/`, category: entry.data.category }));
const legacy = (await getCollection('legacy')).map((entry) => ({ entry, meta: legacyMetadata(entry) })).filter(({ meta }) => meta.tags.includes(tag)).map(({ entry, meta }) => ({
  ...entry,
  data: { ...meta, date: undefined },
  kind: 'Note' as const,
  href: `/notes/${meta.slug}/`,
  category: meta.category,
}));
const entries = [...blog, ...notes, ...legacy].sort((a, b) => ((b.data.date as Date | undefined)?.valueOf() ?? 0) - ((a.data.date as Date | undefined)?.valueOf() ?? 0) || a.data.title.localeCompare(b.data.title, 'zh-CN'));
---
<BaseLayout title={`#${tag}`} description={`标签 ${tag} 下的技术文章与笔记。`}>
  <div class="container page">
    <header class="page-header"><span class="eyebrow">Topic</span><h1>#{tag}</h1><p>{entries.length} 篇相关内容。</p></header>
    <div class="post-list">{entries.map((entry) => <PostCard title={entry.data.title} description={entry.data.description} date={entry.data.date} tags={entry.data.tags} body={entry.body} kind={entry.kind} category={entry.category} href={entry.href} />)}</div>
  </div>
</BaseLayout>
