---
const path = Astro.url.pathname;
const nav = [
  ['Home', '/'],
  ['Blog', '/blog/'],
  ['Notes', '/notes/'],
  ['Projects', '/projects/'],
  ['About', '/about/'],
  ['Search', '/search/'],
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Miyako 首页">
      <span class="brand-mark" aria-hidden="true">M</span>
      <span>Miyako<span class="brand-dot">.</span></span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {nav.map(([label, href]) => (
        <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="icon-button desktop-only" href="https://github.com/SAM0619TJ" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.4 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2A11 11 0 0 1 12 6.3c1 0 2 .1 2.9.4 2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"/></svg>
      </a>
      <button class="icon-button" id="theme-toggle" type="button" aria-label="主题：跟随系统" title="切换主题模式">
        <svg class="theme-system" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <svg class="theme-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14Z"/></svg>
      </button>
      <button class="icon-button mobile-menu-button" id="menu-toggle" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label="打开导航菜单">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label="移动端导航" hidden>
    {nav.map(([label, href]) => (
      <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>
    ))}
    <a href="https://github.com/SAM0619TJ" target="_blank" rel="noopener noreferrer">GitHub</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const menu = document.querySelector<HTMLElement>('#mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? '打开导航菜单' : '关闭导航菜单');
    if (menu) menu.hidden = open;
  });
</script>
